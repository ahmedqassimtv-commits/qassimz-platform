---
import BaseLayout from '../layouts/BaseLayout.astro'
import { books, mahkaaStories, sources } from '../data/space'
---

<BaseLayout title="مساحة" description="مساحة — المكتبة والحكايات والمصادر في قَاسِمز.">
  <section class="mx-auto max-w-6xl px-5 pt-16">
    <h1 data-headline class="font-display text-4xl font-black md:text-5xl">مساحة</h1>
    <p class="mt-3 text-ink-dim">المكتبة، والحكايات المصوّرة، والمصادر — مساحة هادئة للقراءة والبحث.</p>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <a href="/episodes" class="card block p-7 hover:border-accent" data-reveal>
        <h2 class="font-display text-2xl font-black">مَحْكاة</h2>
        <p class="mt-2 text-ink-dim">حكايات مصوّرة ومتسلسلة.</p>
        <p class="mt-4 font-bold text-accent"><bdi>{mahkaaStories.length}</bdi> حكاية منشورة</p>
      </a>
      <a href="/books" class="card block p-7 hover:border-accent" data-reveal>
        <h2 class="font-display text-2xl font-black">الكتب</h2>
        <p class="mt-2 text-ink-dim">مكتبة قَاسِمز — كتب مختارة.</p>
        <p class="mt-4 font-bold text-accent"><bdi>{books.length}</bdi> كتاب منشور</p>
      </a>
      <a href="/sources" class="card block p-7 hover:border-accent" data-reveal>
        <h2 class="font-display text-2xl font-black">المصادر</h2>
        <p class="mt-2 text-ink-dim">مراجع ومصادر الحكايات والمقالات.</p>
        <p class="mt-4 font-bold text-accent"><bdi>{sources.length}</bdi> مصدر منشور</p>
      </a>
    </div>
  </section>
</BaseLayout>
