---
import BaseLayout from '../layouts/BaseLayout.astro'
import { videos } from '../data/videos'

const longVideos = videos.filter((v) => v.type === 'long')
const shortVideos = videos.filter((v) => v.type === 'short')
---

<BaseLayout title="الفيديوهات" description="فيديوهات قَاسِمز: وثائقيات وحلقات ولقطات قصيرة.">
  <section class="mx-auto max-w-6xl px-5 pt-16">
    <h1 data-headline class="font-display text-4xl font-black md:text-5xl">الفيديوهات</h1>
    <p class="mt-3 text-ink-dim">وثائقيات وحلقات ولقطات قصيرة — <bdi>{videos.length}</bdi> فيديوهات منشورة.</p>

    <h2 class="font-display mt-12 text-2xl font-black">حلقات ووثائقيات</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {longVideos.map((video) => (
        <article class="card overflow-hidden" data-reveal>
          <a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noreferrer">
            <img src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`} alt={video.title} class="h-48 w-full object-cover" loading="lazy" />
          </a>
          <div class="p-5">
            <p class="text-sm text-ink-dim">{video.category} · <bdi>{video.date}</bdi></p>
            <h3 class="font-display mt-1 text-xl font-black">{video.title}</h3>
            <p class="mt-2 text-ink-dim">{video.summary}</p>
          </div>
        </article>
      ))}
    </div>

    <h2 class="font-display mt-12 text-2xl font-black">لقطات قصيرة</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {shortVideos.map((video) => (
        <article class="card overflow-hidden" data-reveal>
          <a href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noreferrer">
            <img src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`} alt={video.title} class="h-48 w-full object-cover" loading="lazy" />
          </a>
          <div class="p-5">
            <p class="text-sm text-ink-dim">{video.category} · <bdi>{video.date}</bdi></p>
            <h3 class="font-display mt-1 text-xl font-black">{video.title}</h3>
            <p class="mt-2 text-ink-dim">{video.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
