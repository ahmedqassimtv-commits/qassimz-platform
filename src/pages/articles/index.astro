---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date),
)
---

<BaseLayout title="المقالات" description="مقالات قَاسِمز عن الصورة والسينما.">
  <section class="mx-auto max-w-6xl px-5 pt-16">
    <h1 data-headline class="font-display text-4xl font-black md:text-5xl">المقالات</h1>
    <p class="mt-3 text-ink-dim">تأملات في الصورة والسينما — <bdi>{articles.length}</bdi> مقالات منشورة.</p>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {articles.map((article) => (
        <article class="card p-7" data-reveal>
          <p class="text-sm text-ink-dim">{article.data.category} · <bdi>{article.data.date}</bdi></p>
          <h2 class="font-display mt-2 text-2xl font-black">{article.data.title}</h2>
          <p class="mt-2 text-ink-dim">{article.data.excerpt}</p>
          <a href={`/articles/${article.slug}`} class="mt-4 inline-block font-bold text-accent">اقرأ المقال ←</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
